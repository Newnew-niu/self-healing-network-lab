# GENERATED by `netpulse configs` from intent/network.yml - do not edit by hand.
name: {{ intent.lab_name }}

mgmt:
  network: {{ intent.mgmt.network }}
  ipv4-subnet: {{ intent.mgmt.subnet }}

topology:
  nodes:
{% for dev in routers %}
    {{ dev.name }}:
      kind: linux
      image: {{ intent.images.frr }}
      mgmt-ipv4: {{ dev.mgmt_ip }}
      labels: {role: {{ dev.role }}}
      binds:
        - ../configs/{{ dev.name }}/frr.conf:/etc/frr/frr.conf
        - ../configs/common/daemons:/etc/frr/daemons
        - ../configs/common/vtysh.conf:/etc/frr/vtysh.conf
{% if execs[dev.name] %}
      exec:
{% for cmd in execs[dev.name] %}
        - {{ cmd }}
{% endfor %}
{% endif %}
{% endfor %}
{% for dev in hosts %}
    {{ dev.name }}:
      kind: linux
      image: {{ intent.images.host }}
      mgmt-ipv4: {{ dev.mgmt_ip }}
      labels: {role: host}
      exec:
{% for cmd in execs[dev.name] %}
        - {{ cmd }}
{% endfor %}
{% endfor %}
    prometheus:
      kind: linux
      image: {{ intent.images.prometheus }}
      mgmt-ipv4: {{ monitoring.prometheus_ip }}
      binds:
        - ../monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      ports:
        - 9090:9090
    grafana:
      kind: linux
      image: {{ intent.images.grafana }}
      mgmt-ipv4: {{ monitoring.grafana_ip }}
      binds:
        - ../monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
        - ../monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
      env:
        GF_AUTH_ANONYMOUS_ENABLED: "true"
        GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      ports:
        - 3000:3000

  links:
{% for link in intent.links %}
    - endpoints: ["{{ link.a }}:{{ link.a_if }}", "{{ link.b }}:{{ link.b_if }}"]
{% endfor %}
